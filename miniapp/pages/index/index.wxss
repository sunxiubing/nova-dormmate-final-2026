/* 全局页面背景 */
.container {
  min-height: 100vh;
  background-color: #f4f6f9;
  padding: 30rpx;
  box-sizing: border-box;
}

/* --- 顶部大标题区 --- */
.header-area {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.logo-box {
  width: 80rpx;
  height: 80rpx;
  background-color: #007aff;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.title-box { display: flex; flex-direction: column; }
.main-title { font-size: 36rpx; font-weight: bold; color: #333; }
.sub-title { font-size: 24rpx; color: #888; margin-top: 6rpx; }

/* --- 卡片基础样式 --- */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.card-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 24rpx; display: block; }

/* --- 数据录入卡片 --- */
.input-item { margin-bottom: 24rpx; }
.input-label { font-size: 28rpx; color: #333; display: block; margin-bottom: 10rpx; }
.input-box {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 1px solid #e5e5e5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.input-hint { font-size: 22rpx; color: #999; display: block; margin-top: 10rpx; }

/* 按钮行 */
.btn-row { display: flex; gap: 20rpx; margin-top: 30rpx; }
.btn-analyze { flex: 1; background-color: #007aff; color: #fff; font-size: 30rpx; border-radius: 8rpx; }
.btn-clear { flex: 1; background-color: #fff; border: 1px solid #ccc; color: #333; font-size: 30rpx; border-radius: 8rpx; }

/* --- 状态与建议卡片 --- */
.status-banner {
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}
/* --- 状态色板：与 web/style.css 的变量表逐值对齐，两端截图放一起应当看不出差别 ---
   偏冷 cold #2f7df6 ｜ 偏热 hot #dd4b32 ｜ 偏湿 wet #7c53e0 ｜ 正常 normal #12996b
   原来是 banner-normal 蓝 / banner-warning 橙 / banner-danger 红，只有三档且对不上 web，
   现在扩成四档按状态取色 */
.banner-normal { background: #e3f6ee; color: #12996b; }
.banner-cold   { background: #e6f0fe; color: #2f7df6; }
.banner-hot    { background: #fdeae6; color: #dd4b32; }
.banner-wet    { background: #efe9fd; color: #7c53e0; }

.mini-cards { display: flex; gap: 20rpx; margin-bottom: 30rpx; }
.mini-card { flex: 1; background: #f8f9fa; padding: 20rpx; border-radius: 12rpx; }
.mini-label { font-size: 24rpx; color: #666; display: block; }
.mini-value { font-size: 40rpx; font-weight: bold; color: #333; display: block; margin: 10rpx 0; }
.mini-tag { display: inline-block; padding: 4rpx 16rpx; border-radius: 6rpx; font-size: 22rpx; }
/* 温度/湿度数值下方的状态标签。原来 tag-normal 和 tag-cold 都是同一个蓝，
   正常与偏冷在视觉上分不开；现在正常独立成绿，偏湿从橙色改成 web 的紫 */
.tag-normal { background: #e3f6ee; color: #12996b; }
.tag-cold   { background: #e6f0fe; color: #2f7df6; }
.tag-hot    { background: #fdeae6; color: #dd4b32; }
.tag-wet    { background: #efe9fd; color: #7c53e0; }

.suggestions-box { font-size: 26rpx; color: #555; margin-bottom: 20rpx; }
.suggestion-title { font-size: 26rpx; font-weight: bold; display: block; margin-bottom: 10rpx; }
.suggestion-item { margin-top: 10rpx; line-height: 1.6; }
.analysis-time { text-align: right; font-size: 22rpx; color: #999; }

/* --- 历史记录卡片 --- */
.history-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.history-right { display: flex; align-items: center; gap: 20rpx; }
.count-text { font-size: 24rpx; color: #007aff; background: #e6f7ff; padding: 4rpx 16rpx; border-radius: 20rpx; }
.btn-export { font-size: 24rpx; padding: 0 20rpx; height: 50rpx; line-height: 50rpx; background: #f0f0f0; color: #333; margin: 0; }

.history-list { display: flex; flex-direction: column; gap: 16rpx; }
.history-item { display: flex; background: #fff; border: 1px solid #f0f0f0; border-radius: 12rpx; padding: 20rpx; align-items: center; }
.status-bar { width: 6rpx; height: 60rpx; border-radius: 4rpx; margin-right: 20rpx; }
/* 原来只有三档，偏湿的记录拿不到任何一条规则，竖条完全不显示颜色 —— 这里补上 .wet */
.status-bar.normal { background: #12996b; }
.status-bar.cold   { background: #2f7df6; }
.status-bar.hot    { background: #dd4b32; }
.status-bar.wet    { background: #7c53e0; }

.history-info { flex: 1; display: flex; flex-direction: column; }
/* 编号和时间紧挨着排（web 端 .history__item 的 gap:12px 同款距离）。
   原来是 space-between，把 #1 顶到最左、时间顶到最右，中间空出一整行 */
.history-top { display: flex; justify-content: flex-start; align-items: baseline; gap: 16rpx; margin-bottom: 10rpx; }
.history-id { font-size: 24rpx; color: #999; }
.history-time { font-size: 24rpx; color: #888; }
.history-data { font-size: 28rpx; font-weight: 500; color: #333; }

.history-tag { font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 8rpx; }
.history-tag.normal { background: #e3f6ee; color: #12996b; }
.history-tag.cold   { background: #e6f0fe; color: #2f7df6; }
.history-tag.hot    { background: #fdeae6; color: #dd4b32; }
.history-tag.wet    { background: #efe9fd; color: #7c53e0; }

.empty-state { text-align: center; font-size: 26rpx; color: #999; padding: 40rpx 0; }

/* --- B4 宿舍实时状态卡 --- */
.node-list { display: flex; flex-direction: column; gap: 12rpx; }
.node-row { display: flex; align-items: center; padding: 16rpx; background: #f8f9fa; border-radius: 10rpx; }
.node-name { width: 130rpx; font-size: 28rpx; font-weight: bold; color: #333; }
.node-value { flex: 1; font-size: 26rpx; color: #555; }
/* 「更新于 …」贴在标题行右侧，字号比标题小一档，不抢主信息 */
.node-updated { font-size: 22rpx; color: #999; }