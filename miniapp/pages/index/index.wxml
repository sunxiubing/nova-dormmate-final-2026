<view class="container">

  <!-- 顶部大标题区（完全复刻） -->
  <view class="header-area">
    <view class="logo-box">DM</view>
    <view class="title-box">
      <text class="main-title">DormMate 温湿度监测</text>
      <text class="sub-title">输入当前读数，获取宿舍环境状态与改善建议</text>
    </view>
  </view>

  <!-- 主要内容区：分为上下两部分（模拟Web的左右两栏，手机屏幕窄所以改为上下排列） -->
  <view class="main-content">
    
    <!-- 上部：数据录入 & 状态建议 -->
    <view class="top-cards">
      
      <!-- 卡片1：数据录入 -->
      <view class="card">
        <text class="card-title">数据录入</text>
        
        <view class="input-item">
          <text class="input-label">温度 (°C)</text>
          <input class="input-box" type="digit" value="{{temp}}" placeholder="请输入温度" bindinput="onTempInput" />
          <text class="input-hint">有效范围 -20 - 60 °C，超出视为异常读数</text>
        </view>

        <view class="input-item">
          <text class="input-label">湿度 (%)</text>
          <input class="input-box" type="digit" value="{{humi}}" placeholder="请输入湿度" bindinput="onHumiInput" />
          <text class="input-hint">有效范围 0 - 100 %，超出视为异常读数</text>
        </view>

        <view class="btn-row">
          <button class="btn-analyze" bindtap="handleAnalyze">分析</button>
          <button class="btn-clear" bindtap="handleClear">清空</button>
        </view>
      </view>

      <!-- 卡片2：状态与建议 -->
      <view class="card">
        <text class="card-title">状态与建议</text>
        
        <!-- 动态横幅：class 也跟着状态走，否则不论什么状态都是同一个底色。
             文字直接用 analysisResult.bannerText —— 原来这里是 currentStatus，
             而 currentStatus 只有「从服务端同步」那条路径才会写，手动分析时它一直是空的 -->
        <view class="status-banner {{analysisResult.bannerClass}}">
           {{analysisResult.bannerText}}
        </view>

        <!-- 数据小卡片：数值和它下面的标签必须同源。
             原来数值取 currentTemp（只有同步历史时才写），标签取 analysisResult.tempStatus
             （只有手动分析时才写），两者各写各的，会出现「数值是同步来的、标签是上次分析的」这种错配 -->
        <view class="mini-cards">
          <view class="mini-card">
            <text class="mini-label">温度</text>
            <text class="mini-value">{{analysisResult.temp}}</text>
            <text class="mini-tag {{analysisResult.tempClass}}">{{analysisResult.tempStatus}}</text>
          </view>
          <view class="mini-card">
            <text class="mini-label">湿度</text>
            <text class="mini-value">{{analysisResult.humi}}</text>
            <text class="mini-tag {{analysisResult.humiClass}}">{{analysisResult.humiStatus}}</text>
          </view>
        </view>
          <!-- 改善建议 -->
        <view class="suggest-list">
         
        </view>
           <!-- 分析时间 -->
       

        <!-- 建议列表 -->
        <view class="suggestions-box">
          <text class="suggestion-title">改善建议</text>
          <view class="suggestion-item" wx:for="{{analysisResult.suggestions}}" wx:key="*this">
            • {{item}}
          </view>
        </view>

        <text class="analysis-time">分析时间：{{analysisResult.time || '--'}}</text>
      </view>

    </view>

    <!-- B4：宿舍实时状态卡。三间房一行一个 —— 手机上就着碎片时间看一眼「现在怎么样」，
         温湿度加一个状态标签够了；异常类型/持续时长/处置到哪一步不搬过来，
         那些是 Dashboard 和复盘报告的事，同一段信息复制到每个页面反而没人知道该看哪页 -->
    <view class="card">
      <view class="history-header">
        <text class="card-title">宿舍实时状态</text>
        <text class="node-updated">{{nodeStatus.updatedAt ? '更新于 ' + nodeStatus.updatedAt : ''}}</text>
      </view>

      <view class="node-list" wx:if="{{nodeStatus.list.length}}">
        <view class="node-row" wx:for="{{nodeStatus.list}}" wx:key="name">
          <text class="node-name">{{item.name}}</text>
          <text class="node-value">{{item.temp}} °C / {{item.humi}} %</text>
          <view class="history-tag {{item.statusClass}}">{{item.statusText}}</view>
        </view>
      </view>

      <view wx:if="{{!nodeStatus.list.length}}" class="empty-state">
        暂无看板数据：请启动 app.py 并打开 Dashboard 页面
      </view>
    </view>

    <!-- 下部：历史记录 -->
    <view class="card">
      <view class="history-header">
        <text class="card-title">历史记录</text>
        <view class="history-right">
          <text class="count-text">{{historyList.length}} 条</text>
          <button class="btn-export" bindtap="handleExportCSV">导出 CSV</button>
        </view>
      </view>

      <!-- 动态渲染历史记录列表 -->
      <view class="history-list">
        <view class="history-item" wx:for="{{historyList}}" wx:key="id">
          <!-- 左侧竖条 -->
          <view class="status-bar {{item.statusClass}}"></view>
          
          <!-- 中间内容 -->
          <view class="history-info">
            <!-- 编号靠左、完整时间靠右。时间是后端 CSV 的 time 列，格式 YYYY-MM-DD HH:mm:ss，
                 和 web 端 formatTime 的输出完全一致；万一某行缺时间，兜底显示占位而不是留白 -->
            <view class="history-top">
              <text class="history-id">#{{item.id}}</text>
              <text class="history-time">{{item.time || '时间未知'}}</text>
            </view>
            <view class="history-bottom">
              <text class="history-data">温度 {{item.temp}} °C · 湿度 {{item.humi}} %</text>
            </view>
          </view>

          <!-- 右侧状态标签 -->
          <view class="history-tag {{item.statusClass}}">
            {{item.statusText}}
          </view>
        </view>

        <!-- 空状态 -->
        <view wx:if="{{historyList.length === 0}}" class="empty-state">
          暂无数据，请去 Web 端点击同步
        </view>
      </view>
    </view>

  </view>
</view>